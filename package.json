{
  "name": "@mastra/discord",
  "version": "0.0.0",
  "description": "Discord channel wrapper for Mastra — a ChannelProvider over @chat-adapter/discord.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chat-adapter/discord": "^4.32.0"
  },
  "peerDependencies": {
    "@mastra/core": "^1.22.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.49.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "undici": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mastra",
    "discord",
    "chatbot",
    "ai",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "channels/discord"
  },
  "homepage": "https://mastra.ai",
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
