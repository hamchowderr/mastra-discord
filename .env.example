# @mastra/discord — example env (never commit real values; use Infisical)

# Bot token (Developer Portal → Bot). @chat-adapter/discord reads this.
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Application public key (Developer Portal → General Information) — used for Ed25519 request verification.
DISCORD_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE

# Application (client) ID.
DISCORD_APPLICATION_ID=YOUR_APPLICATION_ID_HERE

# Optional: role IDs that count as a mention trigger (comma-separated).
DISCORD_MENTION_ROLE_IDS=

# Public HTTPS base URL for the interactions endpoint (or auto-detected from the Mastra server).
MASTRA_SERVER_BASE_URL=https://your-app.example.com

# Storage for ChannelsStorage (installations). Postgres or libSQL.
DATABASE_URL=postgres://...
